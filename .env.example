# Resend (servidor — não uses prefixo VITE_)
# https://resend.com/api-keys
RESEND_API_KEY=

# Email onde queres receber os pedidos de orçamento
RESEND_TO_EMAIL=

# Remetente verificado no Resend (domínio ou sandbox de testes)
# Ex.: Linean <onboarding@resend.dev> (só para testes) ou Orcamentos <orcamentos@teudominio.pt>
RESEND_FROM_EMAIL=

# Opcional: URL base da API se o site estático e a API estiverem em hosts diferentes
# VITE_CONTACT_API_URL=https://teu-projeto.vercel.app
